<turbo-frame id="tbl-orders">
    {{#each orders}}
    <div class="card mb-4 shadow-sm">
        <div class="card-body d-flex gap-4">
            <a href="/san-pham/{{this.Slugs}}" target="_top" class="d-flex align-items-center">
                <img src="/{{this.Image}}" alt="{{this.ProdName}}" class="rounded"
                    style="width: 120px; height: auto; object-fit: cover;">
            </a>

            <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <strong class="fs-5">{{this.ProdName}}</strong>
                    <p class="text-muted mb-0">Mã đơn hàng: <strong>{{this.Id}}-{{this.Code}}</strong></p>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <p><strong>Khách hàng</strong>: {{this.FullName}}</p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>SDT</strong>: {{this.PhoneNumber}}</p>
                    </div>
                    <div class="col-md-4">
                        <p><strong>Địa chỉ giao</strong>: {{this.AddressLine}}</p>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <p><strong>Số lượng</strong>: {{this.Quantity}}</p>
                    <p class="text-success fs-5 mb-0">
                        <strong class="text-black fs-6">Tổng tiền thanh toán</strong>: {{formatNumToCurrency
                        this.TotalPrice}} ₫
                    </p>
                </div>
            </div>

            <div class="d-flex flex-column align-items-center" style="min-width: 150px">
                <p class="fw-bold">Tình trạng đơn hàng</p>
                {{#if (eq this.Status 'Processing')}}
                <p class="text-warning">Chờ duyệt</p>
                <button class="btn btn-primary" onclick="updateOrderStatus('{{this.Id}}', 'Delivering')">
                    Duyệt đơn</button>
                {{/if}}

                {{#if (eq this.Status 'Delivering')}}
                <p class="text-info">Đang vận chuyển</p>
                {{/if}}

                {{#if (eq this.Status 'Completed')}}
                <p class="text-success">Giao thành công</p>
                {{/if}}

                {{#if (eq this.Status 'Cancelled')}}
                <p class="text-danger">Đã huỷ</p>
                {{/if}}
            </div>
        </div>
    </div>
    {{/each}}
</turbo-frame>

<script src="/js/admin/order.js"></script>