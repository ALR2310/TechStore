{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "outDir": "dist",
        "rootDir": ".",
        "noEmit": true,
        "paths": {
            "~": ["./"],
            "~/*": ["./*"],
            "@shared/*": ["../shared/*"]
        }
    },
    "include": ["./", "../shared"],
    "exclude": ["../server"]
}