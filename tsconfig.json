{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "rootDir": "admin",
        "outDir": "dist-admin",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "admin/**/*"
    ],
    "exclude": [
        "node_modules",
        "user"
    ]
}