        "Asus",
        "bootstrap",
        "chien",
        "dracula",
        "hieu",
        "Inspiron",
        "lenovo",
        "nguyen",
        "OLD",
        "originalname",
        "pham",
        "protocolipport",
        "Victus",
        "viec",
        "Vostro"
    ]
}